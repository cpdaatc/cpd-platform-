NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
PRODUCTION_BASE_URL=https://cpd.example.org
# Preferred current server-only secret for Supabase admin operations such as user invitations.
SUPABASE_SECRET_KEY=server-only-never-expose-to-browser
# Legacy fallback supported by the code when a project still uses service_role JWT keys.
# SUPABASE_SERVICE_ROLE_KEY=server-only-never-expose-to-browser
NEXT_PUBLIC_DEMO_MODE=false
