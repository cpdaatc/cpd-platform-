{
  "name": "cpd-governance-platform",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/login-smoke.spec.ts tests/e2e/responsive-accessibility.spec.ts",
    "test:e2e:auth": "playwright test tests/e2e/login-role-context.spec.ts tests/e2e/activity-lifecycle.spec.ts tests/e2e/reports-print.spec.ts tests/e2e/full-governed-journey.spec.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "security:release": "node scripts/security-release-check.mjs",
    "production:env-check": "node scripts/production-env-check.mjs",
    "production:smoke": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "next": "16.2.11",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "16.2.11",
    "jsdom": "^26.0.0",
    "supabase": "2.110.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "overrides": { "postcss": "8.5.23", "sharp": "0.35.0" }
}
